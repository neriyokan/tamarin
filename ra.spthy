    [
        App_to_Enclave(pid_app, pid_daemon
                        , <'return_evidences'
                        , <'quote', PCR_tcb_recv, quote>
                        , <'counter', %x, sig_counter>
                        , <'host_hash', host_hash_recv>
                        >)
    ]
*/
//#endif

//Integrity


/* ==============================================================================
   3. Correctness Trace (Lemmas)
   ============================================================================== */
lemma correctness_trace:
    exists-trace
    "
    Ex  nonce quote PCR_tcb host_code_hash host_hash_sealkey 
        sig_counter %new ak key //%cnt %old
        #a #b #c #d #e #f #g #i0 #i #j0 #j #k #l #m #n #o.
        
        KMSIssuedNonce(nonce) @ #a &
        Enclave_Recv_Nonce(nonce) @ #b &
        Host_Recv_Nonce(nonce) @ #c &
        Attest_request_Host_To_Daemon(nonce) @ #d &
        Attest_request_Recv_Daemon(nonce) @ #e &
        CreateEvidences(quote, PCR_tcb, host_code_hash, nonce) @ #f & //nonceいれなかったら#gが通らない
        //CreateRuntimeEvidence(host_hash_sealkey) @ #f &
        //CreateSignCounter(sig_counter) @ #f &
        //IncrementCounter(%old, %old %+ %1) @ #f &
        Recv_quote_Host(quote, PCR_tcb, host_code_hash, nonce) @ #g & //nonceいれなかったら#gが通らない
        EnclaveRecvEvidences(PCR_tcb, quote, %new, sig_counter, host_code_hash, host_hash_sealkey) @ #i0 &
        EnclaveVerified(host_hash_sealkey, sig_counter, ak) @ #i &
        //EnclaveSignVerified(sig_counter, ak) @ #i &
        //EnclaveCounterRecv(%old, %new, ak) @ #i &
        KMSRecvEvidences(PCR_tcb, host_code_hash, nonce) @ #j0 &
        KMSVerified(quote, PCR_tcb, host_code_hash, nonce, ak)@ #j & 
        //KMSSignVerified(quote, ak) @ #j &
        KMSSendAccept(PCR_tcb, host_code_hash) @ #k &
        EnclaveRecvAccept(PCR_tcb, host_code_hash, %new, key) @ #l &
        Store(ak, PCR_tcb, host_code_hash, %new, key) @ #m &
        //CounterVerified(%cnt, %new) @ #n &
        LoadSealedState(ak, PCR_tcb, host_code_hash, %new, key) @ #n &
        EnclaveCommit(PCR_tcb, host_code_hash, %new, key) @ #o &
    
        #a < #b & #b < #c & #c < #d  & #d < #e & #e < #f & #f < #g & #g < #i0 & #i0 < #i
        & #i < #j0 & #j0 < #j & #j < #k
        & #k < #l  &  #l < #m  &  #m < #n & #n < #o 
    "
