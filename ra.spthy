theory Enclave_Integrity_Online
begin

builtins: signing, asymmetric-encryption, symmetric-encryption, hashing
builtins: natural-numbers

/* ==============================================================================
   0. グローバル制約 (Restrictions)
   ============================================================================== */
restriction Once:
    "All tag #i #j. 
    Once(tag) @i 
    & Once(tag) @j 
    ==> #i = #j"

restriction Equality:
	"All x y #i. Eq(x, y) @i ==> x = y"

restriction Inequality:
	"All x #i. Neq(x, x) @ #i ==> F"

restriction LessThan:
  "All x y #i.
     LessThan(x,y) @ #i
     ==> x ⊏ y"

/* ==============================================================================
   1. Channel
   ============================================================================== */
//TLS channel
rule TLS_Send_Recv:
    [
        TLS_Send(A, B, <tag, sid, msg>)
    ]
    --[
        TLS_Record(A, B, <tag, sid, msg>)
    ]->
    [
        TLS_Recv(A, B, <tag, sid, msg>)
    ]

//Unix domain socet
rule R_unix_socket_1:
     [ Unix_Socket_Send_via_Host(pid_send, pid_recv, <tag, msg>)
     ]-->[
       Out(<pid_send, pid_recv, <tag, msg>>) ]
rule R_unix_socket_2:
     [ In(<pid_send, pid_recv, <tag, msg>>)
    //[ In(<pid_recv, pid_send, <tag, msg>>)
     ]-->[
      Unix_Socket_Recv_via_Host(pid_recv, pid_send, <tag, msg>) ]

rule R_Ocall_Enclave:
    [ Ocall_enclave(msg)
    ]-->[
        Out(<'ocall', msg>)]
rule R_Ocall_Host:
    [ In(<'ocall', msg>)
    ]-->[
        Ocall_host(msg)]

rule R_Ecall_Host:
    [ Ecall_host(msg)
    ]-->[
       Out(<'ecall', msg>) ]
rule R_Ecall_Enclave:
    [ In(<'ecall', msg>)
    ]-->[
        Ecall_enclave(msg)]
/* ==============================================================================
   2. Roles
   ============================================================================== */
/* deployment */
rule TPM_Init:
     [
       Fr(~sk)
     , Fr(~pcr_tcb)
    ]
     --[ Once('deloyment') ]->
     [
      !TPM('ak_sk', ~sk)
    , !TPM('ak_pk', pk(~sk))
    , !TPM('pcr_tcb', ~pcr_tcb)
    ]

rule Init_Counter:
    []
  --[ 
        Once('init_counter')
        , Value(%1)
  ]->
    [
        !TPMCounter_start()
        , TPM_counter('init', %1)
        , Init_Counter(%1)
    ]
/* Host */
rule Init_Host:
let host_code_hash = h(~host_code) in
    [
        Fr(~host_code)
    ]
    --[ //Once('init_host') 
    ]->
    [
        !Host_start()
        , !HostCode(~host_code)
        , !HostCodeHash(host_code_hash) //Verifier, configに登録する用
        , Host_step1(~host_code, host_code_hash)
    ]
/* 
rule Init_FakedHost:
let faked_host_code_hash = h(~faked_host_code) in
    [
        Fr(~faked_host_code)
        , Fr(~faked_nonce)
    ]
    --[ 
        //Once('init_fakedhost') 
    ]->
    [
        !Host_start()
        , !HostCode(~faked_host_code)
        , !HostCodeHash(faked_host_code_hash) //Verifier, configに登録する用
        , Host_step1(~faked_host_code, faked_host_code_hash)
    ]
*/
/*#ifdef not CUCKOO
rule Init_Process_Global:
    [
        Fr(~host_pid)
        , Fr(~daemon_pid)
    ]
    --[
        Once('init_process_global')
    ]->
    [
        //PID(<'benign', ~host_pid>)
        //, PID(<'Daemon', ~daemon_pid>)
        !PID(~host_pid, ~daemon_pid)
        , !PID_to_Hash(<'benign', ~host_pid>, h(~host_pid))
    ]
#endif

#ifdef CUCKOO
*/
/* Process ID & hash(PID) */
rule Init_Process_Application:
    [
        Fr(~pid_app)
    ]
    --[
        //Once('init_process_app')
        //, CuckooPID(host_pid_hash, faked_host_pid_hash)
    ]->
    [
        !PID_app(~pid_app)
    ]

rule Init_Process_Daemon:
    [
        Fr(~pid_daemon)
    ]
    --[
        //Once('init_process_daemon')
    ]->
    [
        !PID_daemon(~pid_daemon)
    ]
//#endif

/* Enclave */
rule Init_Enclave:
    [
        !TPM('ak_pk', new_ak)
        , !TPM('pcr_tcb', pcr_tcb) //Attestation TCBの完全性は署名検証済みとする
        , !HostCodeHash(host_code_hash) //runtime attestation evidenceフィールド用，デプロイ時にハッシュを取っておくか？
        , Init_Counter(%n)
        , Fr(~seal_key)
        , Fr(~key)//復号鍵の枠
    ]
    --[
        //Once('init_enclave')
        SealKeyCreated(~seal_key)
    ]->
    [
        !SealingKey(~seal_key)
        , !Enclave_start()
        , Enclave_step1(<'config', new_ak, pcr_tcb, host_code_hash, %n, ~key>)
    ]

rule Init_Daemon:
    [
        Fr(~pid_daemon)
    ]
    --[
        //Once('init_daemon')
    ]->
    [
        !Daemon_start()
        , Daemon_step1()
    ]
rule Init_KMS:
    [
        Fr(~nonce)
        , Fr(~sid)
        , !TPM('ak_pk', ak)
        , !TPM('pcr_tcb', PCR_tcb)
        , !HostCodeHash(host_code_hash)
        //Fake host経由のnonce, sidもつくるか？
    ]
    --[
       // Once('init_kms')
    ]->
    [
        !KMS_start()
        , KMS_step1(~sid, ~nonce, ak, PCR_tcb, host_code_hash)
    ]


/* ==============================================================================
   3. プロトコル・ルール
   ============================================================================== */
/*
 * KMS sends server hello with nonce to Enclave for verifying no-replay.　client helloは省略．
 */
rule KMS_Step1:
    [
        !KMS_start()
        , KMS_step1(sid, nonce, ak, PCR_tcb, host_code_hash)
    ]
    --[ 
        //KMSIssuedNonce(sid, nonce)
        KMSIssuedNonce(nonce)
        , Step1()
        ]->
    [
        TLS_Send('KMS', 'Enclave', <'nonce', sid, nonce>)
        , KMS_step2(sid, nonce, ak, PCR_tcb, host_code_hash)
    ]

/* 
 * Enclave receives nonce from KMS 
 * , creates nonce for protecting replay attack between unix domain socket
 * and returns to Host.
 */
rule Enclave_Step1:
    [
        !Enclave_start()
        , Enclave_step1(<'config', ak, PCR_tcb, host_code_hash, %n, key>)
        , TLS_Recv('KMS', 'Enclave', <'nonce', sid, nonce>)
    
    ]
    --[
        Enclave_Recv_Nonce(nonce)
        , Step2()
    ]->
    [
        Enclave_step2(sid, nonce, <'config', ak, PCR_tcb, host_code_hash, %n, key>)
        //, Ocall(nonce)
        , Ocall_enclave(nonce)
    ]

/*
 * Host recv nonce from KMS
 */
rule Host_Step1:
    [
        !Host_start()
        , Host_step1(host_code, host_code_hash)
        //, Ocall(nonce)
        , !PID_app(pid_app)
        , Ocall_host(nonce)
        
    ]
    --[
        Host_Recv_Nonce(nonce)
        , Step3()
    ]->
    [
        Host_step2(nonce, pid_app, host_code, host_code_hash)
    ]

/*
 * Host send nonce to Daemon
 */
rule Host_Step2:
    [
        Host_step2(nonce, pid_app, host_code, host_code_hash)
        , !PID_daemon(pid_daemon)
    ]
    --[
        Attest_request_Host_To_Daemon(nonce)
        , UDS_Host_to_Daemon(pid_app, pid_daemon)
        , Step4()
    ]->
    [
        Unix_Socket_Send_via_Host(
            pid_app, pid_daemon
            , <'attest_request', nonce>
        )
        , Host_step3(nonce, pid_app, pid_daemon, host_code, host_code_hash)
    ]

/*
 * Daemon recives nonce and nonce_uds from Host.
 */
rule Daemon_Step1:
    [
        !Daemon_start()
        , Daemon_step1()
        , Unix_Socket_Recv_via_Host(
            pid_daemon, pid_app,
            <'attest_request', ~nonce>)
        , !HostCode(host_code) //ここでDaemonがHost codeを測定
        , !SealingKey(daemon_seal_key)
    ]
    --[
        Attest_request_Recv_Daemon(~nonce)
        , DaemonSealkey(daemon_seal_key)
        , UDS_Recv_Daemon_from_Host(pid_app, pid_daemon)
    ]->
    [
        Daemon_step2(~nonce, pid_daemon, pid_app, h(host_code), daemon_seal_key)
    ]

/*
 * Daemon creates and signs quote, and increment counter.
 * Daemon sends these to Host on Unix domain socket.
 */
rule Daemon_Step2:
let quote = sign(<'quote', PCR_tcb, nonce>, sk)
    sig_counter = sign(<'counter', (%n %+ %1), nonce>, sk)
    host_hash_sealkey = h(<host_code_hash, nonce, daemon_seal_key>)
    in
    [
        Daemon_step2(nonce, pid_daemon, pid_app, host_code_hash, daemon_seal_key)
        , !TPM('ak_sk', sk)
        , !TPM('pcr_tcb', PCR_tcb)
        , TPM_counter('init', %n)
    ]
    --[
        CreateEvidences(quote, PCR_tcb, host_code_hash, nonce)
        , CreateRuntimeEvidence(host_hash_sealkey)
        , CreateSignCounter(sig_counter)
        , IncrementCounter(%n, %n %+ %1)
        , UDS_Daemon_to_Host(pid_app, pid_daemon)
        , Step6()
    ]->
    [  
        Unix_Socket_Send_via_Host(
            pid_daemon, pid_app, 
            <'return_evidences'
                , <'quote', PCR_tcb, quote>
                , <'counter', (%n %+ %1), sig_counter> //署名したカウンタ
                , <'host_hash_sealkey', host_code_hash, host_hash_sealkey> //h(<app_hash, nonce, sealingkey)
            >
        )
        , TPM_counter('inc', %n %+ %1) //ここからEnclaveがカウンタ取ってはダメでは．Enclaveがカウンタだけもらうruleも必要では
    ]

/*
 * Host recives evidence from Daemon and send it to Enclave.
 */
rule Host_Step3:     
    [
        Host_step3(nonce, pid_app, pid_daemon, host_code, host_code_hash)
        , Unix_Socket_Recv_via_Host(
            pid_app, pid_daemon, 
            <'return_evidences'
            , <'quote', PCR_tcb_recv, quote>
            , <'counter', %x, sig_counter>
            , <'host_hash_sealkey', host_code_hash_recv, host_hash_sealkey_recv>
            >
        )

    ]
    --[
        Recv_quote_Host(quote, PCR_tcb_recv, host_code_hash_recv, nonce)
        , UDS_Recv_Host_from_Daemon(pid_app, pid_daemon)
        , Step7()
    ]->
    [
        //Ecall(pid_app, pid_daemon
        Ecall_host(<'ecall', pid_app, pid_daemon
                        , <'return_evidences'
                        , <'quote', PCR_tcb_recv, quote>
                        , <'counter', %x, sig_counter>
                        , <'host_hash_sealkey', host_code_hash_recv, host_hash_sealkey_recv>
                        >
            >)
    ]

/*
 * Enclave verifies nonce_uds and send data to KMS.
 */
rule Enclave_Step2:
    [
        Enclave_step2(sid, nonce, <'config', ak, PCR_tcb, host_code_hash, %old, old_key>)
        //, Ecall(pid_app, pid_daemon
        , Ecall_enclave(<'ecall', pid_app, pid_daemon
                        , <'return_evidences'
                        , <'quote', PCR_tcb_recv, quote>
                        , <'counter', %new, sig_counter>
                        , <'host_hash_sealkey', host_code_hash_recv, host_hash_sealkey_recv>
                        >
            >)
    ]
    --[
        EnclaveRecvEvidences(PCR_tcb_recv, quote, %new, sig_counter, host_code_hash_recv, host_hash_sealkey_recv)
        , Step8()
    ]->
    [
        Enclave_step3(sid, nonce, PCR_tcb_recv, quote, %new, sig_counter
                        , host_code_hash_recv, host_hash_sealkey_recv
                        , <'config', ak, PCR_tcb, host_code_hash, %old, old_key>
                        )
    ]

rule Enclave_Step3:
let host_hash_recv = h(<host_code_hash_recv, nonce>) in
    [
        Enclave_step3(sid, nonce, PCR_tcb_recv, quote, %new, sig_counter
                        , host_code_hash_recv, host_hash_sealkey_recv
                        , <'config', ak, PCR_tcb, host_code_hash, %old, old_key>
                        )
         , !SealingKey(enclave_sealkey)
    ]
    --[
        Eq(h(<host_code_hash_recv, nonce, enclave_sealkey>), host_hash_sealkey_recv) //Cuckoo, attack surface

        , Eq(verify(sig_counter, <'counter', %new, nonce>, ak), true) //カウンタの署名検証
        , Eq((%old %+ %1), %new) //インクリメント要求が通ったことの確認

        , EnclaveVerified(host_hash_sealkey_recv, sig_counter, ak)
        , EnclaveSignVerified(sig_counter, ak)
        , EnclaveCounterRecv(%old, %new, ak)
        , EnclaveSealkey(enclave_sealkey)
    ]->
    [
        Enclave_step4(%new, <'config', ak, PCR_tcb, host_code_hash, %old, old_key>) //Cuckooは検知済み，まだアテステーション終わってないのでカウンタはインクリメントしない
        , TLS_Send('Enclave', 'KMS', <sid
                                    , <'quote', PCR_tcb_recv, quote>
                                    , <'host_hash', host_code_hash_recv, host_hash_recv> //Enclaveがハッシュを作り直す
                                    >)
    ]

/*
 * KMS recives quote from Enclave and verify.
 */
rule KMS_Step2:
    [
        KMS_step2(sid, nonce, ak, PCR_tcb, host_code_hash)
        , TLS_Recv('Enclave', 'KMS', <sid
                                     , <'quote', PCR_tcb_recv, quote>
                                    , <'host_hash', host_code_hash_recv, host_hash_recv>
                                    >)
    ]
    --[
        KMSRecvEvidences(PCR_tcb_recv, host_code_hash_recv, nonce)
        , Step10()
    ]->
    [
        KMS_step3(sid, nonce, ak, PCR_tcb, host_code_hash
                    , PCR_tcb_recv, quote, host_code_hash_recv, host_hash_recv)
    ]

rule KMS_Step3:
let host_hash = h(<host_code_hash, nonce>) in
    [
        KMS_step3(sid, nonce, ak, PCR_tcb, host_code_hash
                    ,PCR_tcb_recv, quote, host_code_hash_recv, host_hash_recv)
    ]
    --[
        //Eq(verify(sig_host_hash_recv, <'host_hash', h(<host_hash, nonce>)>, ak), true) //ホストハッシュの署名検証
        Eq(h(<host_code_hash, nonce>), host_hash_recv) //Attestation1: Hostcodeの実行時にDaemonがとったハッシュと事前のハッシュが一致しているか

        , Eq(verify(quote, <'quote', PCR_tcb, nonce>, ak), true) //Quoteの署名検証
        , Eq(PCR_tcb_recv, PCR_tcb) //Attestaiton2: PCRが期待するPCRと一致しているか

        , KMSVerified(quote, PCR_tcb_recv, host_code_hash_recv, nonce, ak)
        , KMSSignVerified(quote, ak)
        , Step11()
    ]->
    [
        KMS_step4(sid, nonce, ak, PCR_tcb, host_code_hash)
    ]

/*
 * KMS sends notice of acceptance to Enclave.
 */
rule KMS_Step4:
    [
        KMS_step4(sid, nonce, ak, PCR_tcb, host_code_hash)
        , Fr(~new_key)//復号用の鍵を発行
    ]
    --[
        KMSSendAccept(PCR_tcb, host_code_hash)
        , Step12()
    ]->
    [
        TLS_Send('KMS', 'Enclave', <'accpet', sid, host_code_hash, PCR_tcb, ~new_key>)
    ]

/*
 * Enclave recives the acceptance.
 */
rule Enclave_Step4:
    [
        TLS_Recv('KMS', 'Enclave', <'accpet', sid, host_code_hash, PCR_tcb, new_key>)
        , Enclave_step4(%new, <'config', ak, old_PCR_tcb, old_host_code_hash, %old, old_key>)
    ]
    --[
        EnclaveRecvAccept(PCR_tcb, host_code_hash, %new, new_key)
        , Step13()
    ]->
    [
        Enclave_step5(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>) //attestationできたので，ここでカウンタを更新，新しいエビデンスと，鍵を書き込み
    ]

/*
 * Enclave seals new evidences, host hash, counter, and key in the config file after attestation.
 */
rule Enclave_Step5:
    [
        Enclave_step5(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>)
        , !SealingKey(seal_key)
    ]
    --[
        Store(ak, PCR_tcb, host_code_hash, %new, new_key)
        , Step14()
    ]->
    [
        Out(<'sealing', senc(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>, seal_key)>) //sealingしてconfigに保存，sealing状態は誰でも読める
    ]

/*
 * Enclave unseals them and check counter by compareing TPM counter.
 */
rule Enclave_Step6:
    [
        In(<'sealing', senc(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>, seal_key)>)//sealing configを読み込み
        , !SealingKey(seal_key)
        , TPM_counter('inc', %cnt)
    ]
    --[
        Eq(%cnt, %new)
        , CounterVerified(%cnt, %new)
        , LoadSealedState(ak, PCR_tcb, host_code_hash, %new, new_key)
        , Step15()
    ]->
    [
        Enclave_step6(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>)
        //, TPM_counter('init', %cnt) // for rollback
    ]

/*
 * Enclave runs
 */
rule Enclave_Step7:
    [ 
        Enclave_step6(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>)
    ]
  --[ 
        EnclaveCommit(PCR_tcb, host_code_hash, %new, new_key)
        , Step16()
    ]->
    [   
        Enclave_Running(<'config', ak, PCR_tcb, host_code_hash, %new, new_key>)
        //Config(ak, new_pcr, %new, new_host_hash, new_key)
    ]

/* ==============================================================================
   2. 脅威モデル（攻撃者の能力）
   ============================================================================== */
