    Cuckko_Attacker4(pid_daemon, pid_app, nonce) @ #j &
    Cuckko_Attacker5(pid_app, pid_daemon, PCR_tcb, host_hash, nonce, (%cnt %+ %1)
                    , quote, sig_counter) @ #k &
    Cuckoo_Attacker6(pid_app, pid_daemon, PCR_tcb, host_hash, (%cnt %+ %1)
