/* ==============================================================================
   4. セキュリティ補題 (Lemmas)
   ============================================================================== */

/* 
 * replay attack
 */
#ifdef REPLAY
//KMSがQuoteをVerifiedできたら，そのnonceは1度しか使われない
lemma L_no_replay_attack_on_verifier_fresh:
    "All quote PCR_tcb host_code_hash nonce ak #i.
      KMSVerified(quote, PCR_tcb, host_code_hash, nonce, ak) @ #i
      ==>
      Ex #j.
        KMSIssuedNonce(nonce) @ #j
        & #j < #i
    "
//KMSがQuoteをVerifiedできたら，KMSが発行したnonceと一致している
lemma L_no_replay_attack_on_verifier_unique:
    "All quote1 quote2 PCR_tcb1 PCR_tcb2 host_code_hash1 host_code_hash2 nonce ak #i1 #i2.
            KMSVerified(quote1, PCR_tcb1, host_code_hash1, nonce, ak) @ #i1
            & KMSVerified(quote2, PCR_tcb2, host_code_hash2, nonce, ak) @ #i2
            ==>
            #i1 = #i2
            "
/*lemma two_verified_sessions:
exists-trace
"
Ex quote1 quote2 PCR1 PCR2 host1 host2
   nonce1 nonce2 ak
   #i #j.

    KMSVerified(quote1, PCR1, host1, nonce1, ak) @ #i
  &
    KMSVerified(quote2, PCR2, host2, nonce2, ak) @ #j
  &
    #i < #j
"*/
#endif

#ifdef INTEGRITY
/*
 * Integrity
 * Evidence(PCR_tcb, host_code_hash)の完全性
 * 
 */
//KMSがacceptしたエビデンスと同一のエビデンスをDaemonが作成した
lemma L_integrity1:
  "
    //All recv_quote ak recv_PCR_tcb recv_host_code_hash nonce #i.
    All quote ak PCR_tcb host_code_hash nonce #i.
    KMSVerified(quote, PCR_tcb, host_code_hash, nonce, ak) @ #i
      ==>
      Ex #j.//create_quote PCR_tcb host_code_hash #j.
        CreateEvidences(quote, PCR_tcb, host_code_hash, nonce) @ #j
        //& recv_quote = create_quote
        //& recv_PCR_tcb = PCR_tcb
        //& recv_host_code_hash = host_code_hash
        & #j < #i
    "

//Enclaveがacceptしたエビデンスと同一のエビデンスをDaemonが作成した
lemma L_integrity2:
    "
    //All recv_sig_counter ak recv_host_hash_sealkey #i.
    All sig_counter ak host_hash_sealkey #i.
        EnclaveVerified(host_hash_sealkey, sig_counter, ak) @ #i
        ==>
        Ex #j.//host_hash_sealkey sig_counter #j.
            CreateRuntimeEvidence(host_hash_sealkey) @ #j
            & CreateSignCounter(sig_counter) @ #j
            //& recv_sig_counter = sig_counter
            //& recv_host_hash_sealkey = host_hash_sealkey
            & #j < #i
    "
#endif
#ifdef ROLLBACK
/*
 * Rollback attack
 */
//同じcounterは一度しか更新しない freshness
lemma L_rollback1:
  "
  All %n #i #j.
    IncrementCounter(%n, %n %+ %1) @ #i
    & IncrementCounter(%n, %n %+ %1) @ #j
    ==>
    #i = #j
  "
//同じカウンタで2状態がLoadされない freshness
lemma L_rollback2:
  "
    All ak pcr1 pcr2 host_code_hash1 host_code_hash2 %cnt key1 key2 #i #j.
        Store(ak, pcr1, host_code_hash1, %cnt, key1) @ #i &
        Store(ak, pcr2, host_code_hash2, %cnt, key2) @ #j
        ==>
        pcr1 = pcr2 &
        host_code_hash1 = host_code_hash2 &
        key1 = key2 &
        #i = #j
  "
//すべての場合でconfigのカウンタと現在のカウンタは一致している
//現在のカウンタと等しくないカウンタをもつconfigはLoadしない integrity
lemma L_rollback3:
    "
    All %old %new #i.
        CounterVerified(%old, %new) @ #i
        ==>
        %old = %new
    "
//Enclaveがcounterのインクリメントを要求したあとは，かならず前のcounterよりも大きくなって，1増えている
lemma L_rollback4:
    "
    All %old %new ak #i.
        EnclaveCounterRecv(%old, %new, ak) @ #i
        ==>
        (%old %+ %1) = %new
    "
//TPMカウンタをインクリメントしてからカウンタの署名を検証
lemma L_rollback5:
    "
    All %old %new ak #j.
        EnclaveCounterRecv(%old, %new, ak) @ #j
        ==>
        Ex #i.
            IncrementCounter(%old, %new) @ #i &
            #i < #j
    "
//Configにカウンタを保存するたびにカウンタは大きくなっている
lemma L_rollback6:
    "
    All ak pcr1 pcr2 host_code_hash1 host_code_hash2 %cnt1 %cnt2 key1 key2 #i #j.
        Store(ak, pcr1, host_code_hash1, %cnt1, key1) @ #i &
        Store(ak, pcr2, host_code_hash2, %cnt2, key2) @ #j &
        #i < #j
        ==>
            %cnt1 << %cnt2
    "
//Configが改ざんれていない　integrity
lemma L_rollback7:
    "
    All ak pcr host_code_hash %cnt key #i.
        LoadSealedState(ak, pcr, host_code_hash, %cnt, key) @ #i
        ==>
        Ex #j.
            Store(ak, pcr, host_code_hash, %cnt, key) @ #j &
            #j < #i

    "
#endif

#ifdef CUCKOO
/*
 * Cuckoo Attack
 */
/* 
//HostのPIDに基づいて生成したhashと，Daemonから返ってきたPIDに基づくhashは等しい authenticy
//すべてのtraceの場合で，Hostはhost_hash = host_hash_recv
lemma L_cuckoo1:
    "
    All host_pid_hash host_pid_hash_recv #i.
        AppVerifiedHash(host_pid_hash, host_pid_hash_recv) @ #i
        ==>
        host_pid_hash = host_pid_hash_recv
    "
lemma L_no_cuckoo_enclave_accept:
    "  
    All pid_app pid_daemon nonce PCR_tcb host_hash %cnt
    quote sig_counter %old
    #i #j.
        Cuckko_Attacker5(pid_app, pid_daemon, PCR_tcb, host_hash, nonce, %cnt
                        , quote, sig_counter) @ #i &
        EnclaveVerified(pid_app, pid_daemon, nonce, %old, %cnt) @ #j &
        #i < #j 
        ==>
            F
    "*/

//KMSVerifidできたとき，EnclaveのsealkeyとDaemonのsealkeyはすべての場合で等しい
lemma L_cuckoo1:
    "
    All quote PCR_tcb host_code_hash nonce ak #i.
        KMSVerified(quote, PCR_tcb, host_code_hash, nonce, ak)@ #i 
        ==>
        Ex sealkey #j #k.
        DaemonSealkey(sealkey) @ #j &
        EnclaveSealkey(sealkey) @ #k 
        &  #j < #k
        &   #k < #i
    "
//KMSVerifiedできたとき，Daemon->Enclave->Hostがbindingしている
lemma L_cuckoo2:
    "
    All quote PCR_tcb host_code_hash nonce ak #i.
        KMSVerified(quote, PCR_tcb, host_code_hash, nonce, ak)@ #i 
        ==>
        Ex pid_app pid_daemon #j #k #l #m.
            UDS_Host_to_Daemon(pid_app, pid_daemon) @ #j &
            UDS_Recv_Daemon_from_Host(pid_app, pid_daemon) @ #k &
            UDS_Daemon_to_Host(pid_app, pid_daemon) @ #l &
            UDS_Recv_Host_from_Daemon(pid_app, pid_daemon) @ #m &
            #j < #k  &  #k < #l  & #l < #m  &  #m < #i
    "

#endif

/*
 * sealing keyのsecrecy
 */
 lemma L_seal_key_secrecy:
    "
    All key #i.
        SealKeyCreated(key) @ #i
        ==>
        not (Ex #j. K(key) @ #j)
    "
end