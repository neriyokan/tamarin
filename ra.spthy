    []
    --[]->
    [
        Fake_Ocall()
        , Fake_Ecall()
    ]
rule Ocall:
    [
        Ocall(nonce)
        , Fake_Ocall()
    ]
    --[
        FakeOcall()
    ]->
    [
        Ocall(nonce)
    ]

rule Fake_Ecall:
    [
        Ecall(pid_app, pid_daemon
                        , <'return_evidences'
                        , <'quote', PCR_tcb_recv, quote>
                        , <'counter', %x, sig_counter>
                        , <'host_hash_sealkey', host_code_hash_recv, host_hash_sealkey_recv>
                        >)
        , Fake_Ecall()
    ]
    --[
        FakeEcall()
    ]->
    [
        Ecall(pid_app, pid_daemon
                        , <'return_evidences'
                        , <'quote', PCR_tcb_recv, quote>
                        , <'counter', %x, sig_counter>
                        , <'host_hash_sealkey', host_code_hash_recv, host_hash_sealkey_recv>
                        >)
    ]
*/
